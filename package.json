{
  "name": "ai-customer-support-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Production AI customer support and booking agent for small businesses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
