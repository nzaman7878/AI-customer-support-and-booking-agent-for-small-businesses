# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (Vector Search & Operational DB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_customer_agent?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_customer_agent
MONGODB_VECTOR_INDEX_NAME=default_vector_index

# LLM Providers (OpenAI or Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Calendar Integration
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ai_agent_verify_token_123
